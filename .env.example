# Copy to .env.local (git-ignored) and fill in. Never commit values.

# Lane A: speech and extraction
SPEECH_PROVIDER=deepgram
SPEECH_MODEL=
DEEPGRAM_API_KEY=
AI_PROVIDER=google
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional read-back through the laptop or earbuds
TTS_PROVIDER=none
TTS_MODEL=
TTS_VOICE_ID=
ELEVENLABS_API_KEY=

# Lane B: Stripe test mode only (sk_test_, rk_test_ or rkcs_test_; live keys are refused). See README: Stripe setup.
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to 127.0.0.1:3000/api/stripe/webhook` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# Juniper Cafe's saved billing email. Test mode never emails it; Stripe only needs a valid address.
INVOICE_TEST_RECIPIENT=billing@juniper-cafe.example.com
