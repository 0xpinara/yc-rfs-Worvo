# Database (Supabase Postgres connection string)
DATABASE_URL=

# AI (provider-agnostic; see src/lib/ai/client.ts)
AI_PROVIDER=openai            # openai | google
AI_MODEL=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Voice (ElevenLabs STT + TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Vexo MCP (OAuth 2.1 + PKCE, dynamic client registration)
VEXO_MCP_URL=https://api.vexoai.com/mcp
VEXO_OAUTH_REDIRECT_URI=http://localhost:3000/api/vexo/oauth/callback
TOKEN_ENCRYPTION_KEY=         # 32-byte base64; encrypts stored OAuth tokens

# Stripe (test mode only; drafts are never finalized automatically)
STRIPE_SECRET_KEY=

# Demo
DEMO_MODE=true                # enables /api/demo/reset and labeled fixture fallbacks
