# Planning template only: no runtime or validator exists yet.
# Reconcile with the implemented adapters during scaffolding. Never commit values.
APP_URL=http://localhost:3000

# Server-only database connection; Supabase Auth public project configuration
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Select one extraction provider/model; OpenAI is an alternative during setup
AI_PROVIDER=google
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=

# Needed only for accessible raw-audio transcription
SPEECH_PROVIDER=deepgram
SPEECH_MODEL=
DEEPGRAM_API_KEY=

# Optional phone/headphone speech; no band speaker assumed
TTS_PROVIDER=none
TTS_MODEL=
TTS_VOICE_ID=
ELEVENLABS_API_KEY=

# One business's Stripe sandbox credentials; server-only.
# Use a restricted key with required permissions, never a live key for the demo.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=

# Controlled recipient for synthetic customer setup; never infer from recordings.
# Stripe test-mode send events still do not establish actual email delivery.
INVOICE_TEST_RECIPIENT=

# Verify actual Vexo interfaces before implementation
VEXO_MCP_URL=https://api.vexoai.com/mcp
VEXO_OAUTH_REDIRECT_URI=http://localhost:3000/api/vexo/callback
TOKEN_ENCRYPTION_KEY=

# No identity-switching or reset bypass on public deployments
DEMO_MODE=false
DEMO_IDENTITY_ENABLED=false
ENABLE_DEMO_RESET=false
