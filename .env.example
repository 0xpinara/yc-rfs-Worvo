# Planning template only: no runtime or configuration validator exists yet.
# Reconcile names with the implemented adapters during T01. Never commit values.
APP_URL=http://localhost:3000

# Server-only PostgreSQL connection for Drizzle transactions
DATABASE_URL=

# Supabase Auth project configuration; use the project's publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Initial structured-extraction provider; configure an available model
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=

# Preferred transcription adapter; browser voice provides initial readback
SPEECH_PROVIDER=elevenlabs
SPEECH_MODEL=
ELEVENLABS_API_KEY=

# Server-side Vexo connection; callback matches the canonical API contract
VEXO_MCP_URL=https://api.vexoai.com/mcp
VEXO_OAUTH_REDIRECT_URI=http://localhost:3000/api/vexo/callback
# Server-only base64-encoded 32-byte encryption key; implement validation
TOKEN_ENCRYPTION_KEY=

# Future server-side invoice email adapter; select and verify during T00/T06.
INVOICE_EMAIL_PROVIDER=
INVOICE_EMAIL_API_KEY=
INVOICE_FROM_EMAIL=
# Controlled test recipient only; never infer it from a recording.
INVOICE_TEST_RECIPIENT=

# Explicit local fixture controls, disabled by default.
# Runtime must reject identity bypass and reset controls on public deployments.
# A provider failure must show an error and offer a labeled fallback action.
DEMO_MODE=false
DEMO_IDENTITY_ENABLED=false
ENABLE_DEMO_RESET=false
